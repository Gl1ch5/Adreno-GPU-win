+
+
+/// Row pitch shared by the KMD (GDI shadow/staging surfaces, local present copy)
+/// and the UMD consumers: 32-bit pixels, rows aligned to 256 bytes.
+#[inline]
+pub fn droidvm_pitch(width: u32) -> u32 {
+    width.saturating_mul(4).saturating_add(255) & !255
+}
