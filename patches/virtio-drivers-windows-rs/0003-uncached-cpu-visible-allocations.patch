                 alloc_info.FlagsWddm2_mut().set_AccessedPhysically(true);
                 crate::bringup::record("Alloc3dLastCpuVisible", cpu_visible as u32);
                 crate::bringup::record("Alloc3dLastVirglFlags", alloc_3d.flags);
