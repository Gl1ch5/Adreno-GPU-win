--- a/gpu-wddm/src/adapter.rs
+++ b/gpu-wddm/src/adapter.rs
@@ -2676,7 +2676,10 @@ impl Adapter {
                 // blt present (ETW: Lock/Unlock 4.2 ms for 3.2 MB on 992); the
