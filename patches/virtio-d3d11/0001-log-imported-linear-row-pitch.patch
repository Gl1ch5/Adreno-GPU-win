+
+/* DroidVM diag: does the ICD honour the explicit row pitch of an imported
+ * linear surface?  A mismatch skews every row of small windows/icons. */
+static void log_import_layout(VIRTIO_WDDM_Device *device, VkImage image,
+                              VkDeviceSize want, UINT w, UINT h)
+{
+    VkImageSubresource sub = { .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT };
+    VkSubresourceLayout got = {0};
+    device->vk_GetImageSubresourceLayout(device->vk, image, &sub, &got);
+    if (got.rowPitch != want)
+        ERROR("import layout MISMATCH %ux%u: explicit rowPitch=%llu, ICD rowPitch=%llu offset=%llu",
+              w, h, (unsigned long long)want, (unsigned long long)got.rowPitch, (unsigned long long)got.offset);
+    else
+        VERBOSE("import layout ok %ux%u: rowPitch=%llu", w, h, (unsigned long long)want);
+}
